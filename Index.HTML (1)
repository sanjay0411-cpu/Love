<!doctype html>

<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Happy Birthday ❤️</title>
  <style>
    :root{
      --bg:#fff0f6; --accent:#ff7aa2; --gold:#ffd27f; --text:#2b2b2b;
    }
    *{box-sizing:border-box;font-family: 'Poppins', system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial}
    body{margin:0;background:linear-gradient(180deg,var(--bg),#fff);color:var(--text);overflow:hidden}
    /* floating hearts */
    .heart{position:fixed;left:50%;top:50%;transform:translate(-50%,-50%);pointer-events:none}
    .hearts {position:fixed;inset:0;overflow:hidden;z-index:0}
    .hearts span{position:absolute;display:block;animation:rise 8s linear infinite;opacity:.9;font-size:22px}
    @keyframes rise{0%{transform:translateY(110vh) scale(.6);opacity:0}10%{opacity:1}100%{transform:translateY(-30vh) scale(1);opacity:0}}/* center card */
.wrap{position:relative;z-index:5;min-height:100vh;display:flex;align-items:center;justify-content:center;padding:40px}
.card{width:940px;max-width:95%;background:rgba(255,255,255,0.75);backdrop-filter:blur(6px);border-radius:18px;padding:28px;box-shadow:0 10px 30px rgba(0,0,0,0.08);border:1px solid rgba(255,255,255,0.6)}

.header{display:flex;align-items:center;gap:18px}
.cap{font-size:64px}
h1{margin:0;font-size:28px}
p.lead{margin:6px 0 0;color:#5b5b5b}

/* modal question */
.modal{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;background:linear-gradient(180deg,rgba(0,0,0,0.35),rgba(0,0,0,0.45));z-index:20}
.modal-card{background:#fff;border-radius:14px;padding:26px;max-width:520px;width:92%;text-align:center;box-shadow:0 8px 40px rgba(0,0,0,0.4)}
.question{font-size:20px;margin:8px 0}
.input-row{display:flex;gap:10px;margin-top:16px}
.input-row input{flex:1;padding:12px 14px;border-radius:10px;border:1px solid #eee;font-size:16px}
.btn{padding:10px 14px;border-radius:10px;border:0;background:linear-gradient(90deg,var(--accent),#ff5f8a);color:white;font-weight:600;cursor:pointer}
.btn-secondary{background:transparent;border:1px solid #ffdfe9;color:var(--text)}
.small-note{font-size:13px;color:#777;margin-top:8px}

/* main content */
.stage{display:flex;gap:18px;align-items:flex-start}
.left{flex:1}
.right{width:360px}
.scene{background:linear-gradient(180deg,#fff,#fff0f6);padding:18px;border-radius:14px;min-height:260px;position:relative;overflow:hidden}

/* animals (emoji based) */
.animals{display:flex;flex-wrap:wrap;gap:12px;justify-content:center}
.animal{width:80px;height:80px;border-radius:12px;background:linear-gradient(180deg,#fff,#fffefc);display:flex;align-items:center;justify-content:center;font-size:40px;box-shadow:0 6px 20px rgba(0,0,0,0.06);position:relative}
.animal .name{position:absolute;bottom:6px;font-size:12px;color:#555}

/* tiny animations */
.wiggle{animation:wig 3s ease-in-out infinite}
@keyframes wig{0%{transform:translateY(0) rotate(-2deg)}50%{transform:translateY(-6px) rotate(2deg)}100%{transform:translateY(0) rotate(-2deg)}}
.peek{animation:peek 4s ease-in-out infinite}
@keyframes peek{0%{transform:translateY(0)}30%{transform:translateY(-8px)}60%{transform:translateY(0)}100%{transform:translateY(0)}}
.blink{animation:blink 5s steps(1) infinite}
@keyframes blink{0%,94%{opacity:1}96%{opacity:0}100%{opacity:1}}

/* quotes */
.quotes{display:flex;flex-direction:column;gap:12px}
.quote{background:linear-gradient(180deg,#fff,#fff8fb);padding:12px;border-radius:10px;border:1px solid rgba(255,122,162,0.15);font-size:15px}

/* footer */
.footer{margin-top:18px;text-align:center;color:#7a7a7a;font-size:14px}

/* responsive */
@media(max-width:900px){.stage{flex-direction:column}.right{width:100%}}

  </style>
</head>
<body>
  <div class="hearts" aria-hidden>
    <!-- generate many hearts -->
    <span style="left:8%;animation-duration:9s;font-size:20px">💖</span>
    <span style="left:18%;animation-duration:7s;font-size:26px">💕</span>
    <span style="left:28%;animation-duration:8s;font-size:22px">💘</span>
    <span style="left:38%;animation-duration:10s;font-size:24px">💗</span>
    <span style="left:48%;animation-duration:12s;font-size:30px">💝</span>
    <span style="left:62%;animation-duration:8s;font-size:22px">❤️</span>
    <span style="left:72%;animation-duration:11s;font-size:26px">💞</span>
    <span style="left:82%;animation-duration:9s;font-size:20px">❣️</span>
  </div>  <div class="wrap">
    <div class="card" role="main">
      <div class="header">
        <div class="cap">🦫</div>
        <div>
          <h1>Surprise — For My Babbbyyy Girl 💖</h1>
          <p class="lead">Open your heart, answer the little capybara, and let the love unfold ✨</p>
        </div>
      </div><div style="height:18px"></div>

  <div class="stage">
    <div class="left">
      <div class="scene">
        <div style="text-align:center;margin-top:8px">
          <h2 id="welcomeTitle">A soft little surprise... <span class="blink">✨</span></h2>
          <p style="color:#8b8b8b">(Answer the capybara's question to unlock the surprises)</p>
        </div>

        <div style="margin-top:18px" class="animals" id="animalsArea" aria-hidden>
          <div class="animal wiggle" title="Capybara">🦫<div class="name">Capy</div></div>
          <div class="animal peek" title="Penguin">🐧<div class="name">Pengu</div></div>
          <div class="animal wiggle" title="Cat">🐱<div class="name">Kit</div></div>
          <div class="animal peek" title="Dog">🐶<div class="name">Pup</div></div>
          <div class="animal wiggle" title="Panda">🐼<div class="name">Pandy</div></div>
        </div>

      </div>
    </div>

    <div class="right">
      <div class="scene">
        <h3 style="margin-top:0">Love Notes & Quotes 💌</h3>
        <div class="quotes" id="quotesList">
          <!-- filled after answer -->
        </div>

        <div class="footer">Made with love ❤️ — Edit any text in the code to personalize.</div>
      </div>
    </div>
  </div>

</div>

  </div>  <!-- Opening modal: capybara asks -->  <div class="modal" id="questionModal" role="dialog" aria-modal="true">
    <div class="modal-card">
      <div style="font-size:56px">🦫</div>
      <div class="question">Who is my <strong>babbbyyy</strong> girl? 🥺💕</div>
      <div class="input-row">
        <input id="answerInput" placeholder="type your answer... (hint: it's tiny & true)" aria-label="answer input">
        <button class="btn" id="submitBtn">Send</button>
      </div>
      <div style="display:flex;gap:8px;justify-content:center;margin-top:12px">
        <button class="btn-secondary" id="hintBtn">Need a hint? 🕵️‍♀️</button>
        <button class="btn-secondary" id="skipBtn">Skip (try anyway)</button>
      </div>
      <div class="small-note">Tip: answer is <em>its me</em> — case-insensitive. 💗  <div style="margin-top:24px;padding:16px;background:#fff6fa;border-radius:14px;border:1px solid #ffdce7;text-align:center">
    <h3 style="margin:0 0 10px">Capybara Hug Game — Challenge Mode 🦫🔥 🦫💞</h3>
    <p style="margin:0 0 12px;color:#777">How many hugs and hearts can you give the capybara?</p>
    <div style="font-size:64px;margin-bottom:10px" id="gameCapy">🦫</div>
    <button class="btn" onclick="hugCapy()">🤗 Hug</button>
    <button class="btn" style="margin-left:8px" onclick="heartCapy()">💖 Give Heart</button><p style="margin-top:14px;font-size:16px;color:#555"><button class="btn" style="margin-bottom:10px;background:#ffd27f;color:#000" onclick="startTimer()">⏱️ Start 10s Challenge</button>

Hugs: <span id="hugCount">0</span> | Hearts: <span id="heartCount">0</span></p>

  </div></div></div></div>  <!-- music + improvements -->
  <div style="position:fixed;right:16px;bottom:16px;z-index:30">
    <button class="btn" id="playMusic">🎵 Play "Until I Found You"</button>
  </div>  <script>
    // --- behavior ---
    const correctAnswer = 'its me'; // accepted in lowercase
    const modal = document.getElementById('questionModal');
    const input = document.getElementById('answerInput');
    const submit = document.getElementById('submitBtn');
    const hint = document.getElementById('hintBtn');
    const skip = document.getElementById('skipBtn');
    const quotesList = document.getElementById('quotesList');
    const animalsArea = document.getElementById('animalsArea');
    const welcomeTitle = document.getElementById('welcomeTitle');

    // prepare quotes (mixed styles) with emojis
    const quotes = [
      'You are my favorite everything. 💖',
      'I didn\'t know what complete felt like until I met you. 🥹❤️',
      'You are my happiness in human form. 🐼✨',
      'Like a penguin, I\'ll stand by you forever. 🐧❣️',
      'You make my heart wag like a puppy. 🐶💓',
      'You\'re my cozy cuddle person. 😽🌸',
      'With you, every day feels like a warm hug. 🤗💕',
      'My heart found its home in you. 🏡💘'
    ];

    // hint behavior
    hint.addEventListener('click', ()=>{ alert('Hint: Say it like you mean it — two words (try: its me) 💕') })
    skip.addEventListener('click', ()=>{ // let them go ahead but with a playful nudge
      if(confirm('Are you sure you want to skip? The capybara will be a little shy...')){
        openMain();
      }
    });

    function showQuotes(){
      quotesList.innerHTML = '';
      quotes.forEach(q=>{
        const el = document.createElement('div');
        el.className='quote';
        el.innerHTML = emojiDecorate(q);
        quotesList.appendChild(el);
      });
    }

    function emojiDecorate(text){
      // small embellishments: surround with hearts
      return '💗 ' + text + ' 💗';
    }

    function correctAnswerFeedback(){
      // little confetti heart burst
      for(let i=0;i<12;i++){
        const span = document.createElement('span');
        span.textContent = ['💖','💕','💘','💝'][Math.floor(Math.random()*4)];
        span.style.position='fixed';
        span.style.left = (50 + (Math.random()-0.5)*40) + '%';
        span.style.top = (50 + (Math.random()-0.5)*40) + '%';
        span.style.fontSize = (12+Math.random()*26)+'px';
        span.style.zIndex = 40;
        document.body.appendChild(span);
        setTimeout(()=>span.remove(),1800+Math.random()*1000);
      }
    }

    submit.addEventListener('click', ()=>{
      const val = input.value.trim().toLowerCase();
      if(val === correctAnswer){
        modal.style.display='none';
        correctAnswerFeedback();
        setTimeout(openMain, 700);
      } else {
        alert('Aww — not quite! Try again? 💕')
      }
    });

    input.addEventListener('keydown', (e)=>{ if(e.key==='Enter') submit.click() });

    function openMain(){
      modal.style.display='none';
      // make animals more lively
      const kids = animalsArea.querySelectorAll('.animal');
      kids.forEach((k,i)=>{
        k.style.transform='translateY(0)';
        k.style.opacity=1;
      });
      showQuotes();
      welcomeTitle.innerHTML = 'Happy Birthday, my love! 🥳💝';
      // small final message in right panel
      setTimeout(()=>{
        const footer = document.querySelector('.footer');
        footer.innerHTML = 'You unlocked my heart — love you endlessly. 💞';
      },800);
    }

    // play button opens YouTube search for the song (replace with your own mp3 URL if you have)
    document.getElementById('playMusic').addEventListener('click', ()=>{
      // open YouTube search in new tab — convenient if you didn't attach a file
      window.open('https://www.youtube.com/results?search_query=Until+I+Found+You+Stephen+Sanchez', '_blank');
    });

    // small accessibility: focus input
    setTimeout(()=>{ input.focus() },450);

    // if user wants, they can paste an mp3 URL: (not required) - example usage in code comments

    /*
      How to add your own mp3 directly into this page:
      1) Upload an mp3 somewhere (your server, Dropbox public link, etc.)
      2) Replace the playMusic click handler above with code that creates an <audio> element:
         const audio = new Audio('https://example.com/your-file.mp3'); audio.play();
      3) Or place: <audio id="bg" src="YOUR_URL" crossorigin="anonymous"></audio> in the HTML and control it here.
    */

  

    let timerRunning=false;
let timeLeft=10;
let totalScore=0;
let level=1;

function startTimer(){
  if(timerRunning) return;
  timerRunning=true;
  timeLeft=10;
  totalScore=0;
  level=1;
  document.getElementById('hugCount').textContent=0;
  document.getElementById('heartCount').textContent=0;
  document.getElementById('helperRow').style.opacity=0;
  let countDown = setInterval(()=>{
    timeLeft--;
    if(timeLeft<=0){ clearInterval(countDown); timerRunning=false; endGame(); }
  },1000);
}

let timerRunning=false; let timeLeft=10; let totalScore=0;
function startTimer(){ if(timerRunning) return; timerRunning=true; timeLeft=10; totalScore=0; document.getElementById('hugCount').textContent=0; document.getElementById('heartCount').textContent=0; let cd=setInterval(()=>{ timeLeft--; if(timeLeft<=0){ clearInterval(cd); timerRunning=false; endGame(); } },1000);} 

function hugCapy(){
      const hug = document.getElementById('hugCount');
      hug.textContent = Number(hug.textContent) + 1;
      animateCapy('🤗');
    }

    function heartCapy(){(){
      const heart = document.getElementById('heartCount');
      heart.textContent = Number(heart.textContent) + 1;
      animateCapy('💖');
    }

    function animateCapy(emoji){
  const capy = document.getElementById('gameCapy');
  totalScore++;
  levelCheck();
  capy.textContent = emoji + '🦫' + emoji;
  capy.style.transform = 'scale(1.2)';
  setTimeout(()=>{
    capy.style.transform = 'scale(1)';
    capy.textContent = '🦫';
  }, 400);
}(emoji){
      const capy = document.getElementById('gameCapy');
      capy.textContent = emoji + '🦫' + emoji;
      capy.style.transform = 'scale(1.15)';
      setTimeout(()=>{
        capy.style.transform = 'scale(1)';
        capy.textContent = '🦫';
      }, 450);
    }



function levelCheck(){
  const helpers=document.getElementById('helperRow');
  if(totalScore>=10 && level===1){ level=2; helpers.style.opacity=1; alert('Level Up! 🐧 Penguins are cheering for you!'); }
  if(totalScore>=20 && level===2){ level=3; alert('Level Up! 🐼 Pandas are clapping for you!'); }
  if(totalScore>=30 && level===3){ level=4; heartExplosion(); alert('Level Up! 🐱 Cats are throwing hearts for you!'); }
}

function endGame(){
  alert('⏱️ Time's up! You scored '+totalScore+' points!');
  if(totalScore>=25){ heartExplosion(); }
}

function heartExplosion(){
  for(let i=0;i<20;i++){
    const h=document.createElement('span');
    h.textContent='💖';
    h.style.position='fixed';
    h.style.left=(Math.random()*100)+'%';
    h.style.top=(Math.random()*100)+'%';
    h.style.fontSize=(20+Math.random()*30)+'px';
    h.style.zIndex=50;
    document.body.appendChild(h);
    setTimeout(()=>h.remove(),1200);
  }
}

function endGame(){ alert('⏱️ Time's up! You scored '+totalScore+' points!'); }
</script></body>
</html>